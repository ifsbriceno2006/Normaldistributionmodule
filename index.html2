<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Normal Distribution · Health Sciences Learning Lab</title><meta name="description" content="A guided normal distribution module: empirical rule, z scores, right-tail tables, medical practice and reverse problems."><style>
:root{--ink:#153a3c;--muted:#536b6d;--teal:#087e83;--pale:#e5f4f1;--gold:#f5b65e;--line:#cbdcda;--paper:#fffefa}*{box-sizing:border-box}body{margin:0;background:#f4f5f0;color:var(--ink);font:17px/1.65 system-ui,Arial}header{padding:21px 5%;background:var(--paper);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:15px;align-items:center}header strong{font-size:18px}.badge,.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:2px;font-weight:750}.badge{background:var(--pale);padding:6px 12px;border-radius:20px}.layout{display:grid;grid-template-columns:245px 1fr;max-width:1440px;margin:auto}aside{padding:28px 18px;position:sticky;top:0;height:100vh;overflow:auto}nav button{display:block;background:none;border:0;text-align:left;color:var(--muted);font:inherit;font-size:14px;padding:12px;width:100%;border-radius:8px;cursor:pointer}nav button.active{background:var(--ink);color:white}nav button:hover{outline:1px solid var(--teal)}main{min-width:0;padding:36px 5% 65px;max-width:1150px}.hero{background:var(--ink);color:#fff;padding:38px;border-radius:16px;position:relative}.hero p{max-width:650px;color:#d7ebe8}h1{font:500 clamp(32px,4vw,51px)/1.12 Georgia,serif;margin:12px 0 22px}h2{font:500 32px/1.25 Georgia,serif;margin:5px 0 16px}h3{font-size:20px;margin:0 0 10px}p{margin:10px 0 18px}.section{display:none}.section.active{display:block}.card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:26px;margin:22px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.grid .card{margin:0}.note{padding:17px 20px;border-left:4px solid var(--teal);background:var(--pale);margin:18px 0}.formula{font-size:24px;font-family:Georgia,serif;background:#f2f5ee;padding:20px;text-align:center;border-radius:8px;margin:18px 0}.steps{counter-reset:steps}.steps>div{border-top:1px solid var(--line);padding:15px 0}.steps b{display:block;color:var(--teal)}button,.button{border:0;background:var(--teal);color:white;border-radius:7px;padding:11px 17px;font:600 14px system-ui;cursor:pointer;display:inline-block;text-decoration:none}button.secondary,.button.secondary{background:#e5ece7;color:var(--ink)}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #e89526;outline-offset:3px}input,select,textarea{font:inherit;color:var(--ink);background:white;border:1px solid #9bb9b7;border-radius:6px;padding:8px;max-width:100%}input[type=number]{width:125px}textarea{width:100%;min-height:85px}label{display:inline-block;margin:8px 12px 8px 0}svg{width:100%;height:auto}svg text{font:13px system-ui;fill:var(--ink)}.feedback{margin-top:10px;min-height:24px}.good{color:#126248}.retry{color:#934c15}details{border-top:1px solid var(--line);margin-top:15px;padding-top:12px}summary{cursor:pointer;color:var(--teal);font-weight:650}.check{padding:18px;background:#eef5ef;margin:15px 0;border-radius:8px}.tablewrap{overflow:auto;max-height:420px;border:1px solid var(--line)}table{border-collapse:collapse;width:100%;font-size:14px;text-align:center}th,td{border:1px solid #dae4e1;padding:8px}th{background:#e5eeea;position:sticky;top:0}td.selected{background:var(--gold);font-weight:bold}td.axis{background:#e9f3ef}td[data-z]{cursor:pointer}.worksheet{font-family:Georgia,serif}.worksheet h2,.worksheet h3{text-align:center;font-family:system-ui}.worksheet .box{border:1px solid #556d6e;padding:17px;margin:13px 0;break-inside:avoid}.worksheet .twocol{columns:2;column-gap:24px}.worksheet .twocol .box{display:inline-block;width:100%}.small{font-size:14px;color:var(--muted)}.progress{height:5px;background:#d5e1dc;border-radius:5px;margin:18px 0}.progress span{display:block;height:100%;background:var(--teal);border-radius:5px}.footerbar{display:flex;justify-content:space-between;gap:12px;margin-top:28px}.q{padding:20px 0;border-bottom:1px solid var(--line);break-inside:avoid}.q p{margin:0 0 10px}.status{font-size:13px;color:var(--muted)}a{color:var(--teal)}.shapechoice{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.shapechoice .card{margin:0} .source{font-size:12px;border-top:1px solid var(--line);padding-top:15px;margin-top:25px}.printonly{display:none}@media(max-width:850px){.layout{display:block}aside{position:relative;height:auto;padding:12px}nav{display:flex;overflow:auto}nav button{min-width:150px}main{padding:20px}.grid{grid-template-columns:1fr}.hero{padding:25px}.worksheet .twocol{columns:1}header{flex-wrap:wrap}.shapechoice{grid-template-columns:1fr}}@media print{body{background:white;font-size:11pt}header,aside,.hero,.footerbar,.noprint,button,.status{display:none!important}.layout{display:block}main{padding:0;max-width:none}.section{display:none!important}.section.active{display:block!important}.card{border:0;padding:10px;margin:6px 0}.worksheet .twocol{columns:2}.worksheet .box{font-size:10pt}.printonly{display:block}details:not([open]){display:none}textarea{height:65px;border:1px solid #999}input{border:0;border-bottom:1px solid #777}.q{padding:10px 0}.feedback{display:none}.grid{grid-template-columns:1fr 1fr}.tablewrap{max-height:none;overflow:visible}th{position:static}a{color:black}}
</style></head><body><header><strong>◒ &nbsp; MTH 116 · Learning Lab</strong><span class="badge">Health sciences edition</span></header><div class="layout"><aside><div class="eyebrow">Your learning path</div><div class="progress"><span id="progress"></span></div><nav id="nav"></nav><p class="small">Work in order, pause to practise, then check your reasoning.</p><p id="status" class="status"></p><button class="secondary" onclick="exportWork()">Download my responses</button><p class="small">Progress is saved in this browser only. Answers are for practice, not a secure graded test.</p></aside><main><div class="hero"><div class="eyebrow">From a bell curve to a probability</div><h1>The normal distribution,<br>one step at a time.</h1><p>Explore the 68–95–99.7 rule, turn measurements into z-scores, read a normal table, and work backwards from a percentage.</p><span class="badge" style="color:#153a3c">Learn · Sketch · Calculate · Explain</span></div>
<section class="section" data-title="1. The empirical rule"><div class="card"><h2>Begin with the 68–95–99.7 rule</h2><p>Imagine many measurements from a similar group of patients. If the measurements follow a normal model, most cluster near the average and fewer lie far away. Their smooth model has a bell shape.</p><p>The <b>mean, μ</b> (say “mew”), is the centre. The <b>standard deviation, σ</b> (say “sigma”), describes the spread in the same units as the measurement. A larger σ means a wider bell.</p><div class="note">The empirical rule gives <b>approximate percentages for a normal distribution</b>. It does not apply automatically to every medical measurement.</div><h3>Explore a simulated pulse-rate model</h3><p>Assume pulse rates in a teaching dataset are normal with μ = 76 beats/min and σ = 6 beats/min. Choose how far to move from the centre.</p><label>Distance <select id="bands" onchange="empirical()"><option value="1">1 standard deviation</option><option value="2">2 standard deviations</option><option value="3">3 standard deviations</option></select></label><div id="empcurve"></div><div id="emptext" class="note"></div><table><tr><th>Distance</th><th>Interval</th><th>Inside</th><th>Each outside tail</th></tr><tr><td>μ ± σ</td><td>70 to 82 bpm</td><td>≈ 68%</td><td>≈ 16%</td></tr><tr><td>μ ± 2σ</td><td>64 to 88 bpm</td><td>≈ 95%</td><td>≈ 2.5%</td></tr><tr><td>μ ± 3σ</td><td>58 to 94 bpm</td><td>≈ 99.7%</td><td>≈ 0.15%</td></tr></table><p>Why divide by two? Symmetry shares the outside area equally between the left and right tails. For two SDs: 100% − 95% = 5% outside, so each tail contains 2.5%.</p><p>Useful pieces from the mean outward: <b>34%, 13.5%, 2.35%</b>, then <b>0.15%</b> beyond three SDs, on each side.</p><div id="empchecks"></div></div><div class="card"><h3>A count is an estimate</h3><p>For 200 simulated pulse measurements, the expected count from 64 to 88 bpm is 200 × 0.95 = <b>190</b>. An actual sample may contain a different number. Multiply the proportion by the group size, and round only when reporting an approximate whole-person count.</p><div class="note">All medical scenarios in this module are hypothetical teaching models. The model cutoffs are not diagnostic thresholds.</div></div></section>
<section class="section" data-title="2. Understand the bell"><div class="card"><h2>What does the curve mean?</h2><div class="grid"><div><h3>Four essential properties</h3><ol><li>One smooth, bell-shaped peak.</li><li>Symmetric around its mean.</li><li>Mean = median = mode at the centre.</li><li>Total area = 1, with 0.5 on either side of the mean.</li></ol><p>The tails approach the horizontal axis without touching it. The normal model extends indefinitely in both directions.</p></div><div><h3>Area is probability</h3><p>The height of the curve is a <b>density</b>, not a probability. Probability is the <b>area under the curve over an interval</b>.</p><p>For a continuous measurement P(X = one exact value) = 0. Therefore P(X &lt; a) = P(X ≤ a). Measured values may be rounded, but the mathematical model is continuous.</p><p>We write X ∼ N(μ, σ²). The second number in this notation is the variance, σ², not σ.</p></div></div><div class="note">Always sketch first: mark the mean, mark the boundary or boundaries, shade the requested region, then decide whether your answer should be smaller or larger than 0.5.</div><h3>Which shapes could reasonably fit a normal model?</h3><p>A bell shape suggests a normal approximation; it does not prove exact normality. Strong skew, two peaks or a flat shape call for a different model.</p><div id="shapes" class="shapechoice"></div></div><div class="card"><h3>Data-summary warm-up</h3><p><b>Mean:</b> x̄ = Σx/n. Add all values, then divide by the number of observations. For a frequency table, x̄ = Σfx/Σf.</p><p><b>Median:</b> order values and find the middle. For an even number of values, average the two middle values: (a + b)/2.</p><p><b>Mode:</b> most frequent value. The eight observation times 6, 2, 3, 5, 4, 9, 12, 27 have no mode because no value repeats.</p><p><b>Distribution:</b> a description of the values a variable can take and how frequently they occur, or how probability is spread across them.</p><p>A short, skewed dataset is not made normal by computing its mean. Practise the supplied numerical and frequency datasets in the worksheet bank.</p></div></section>
<section class="section" data-title="3. Standardise with z"><div class="card"><h2>Put any normal measurement on one scale</h2><p>A <b>z-score</b> tells you how many standard deviations a value lies above or below the mean. Subtracting μ measures the gap; dividing by σ expresses that gap in standard-deviation units.</p><div class="formula">z = (x − μ) / σ</div><p><b>x</b> = measurement; <b>μ</b> = population/model mean; <b>σ</b> = population/model SD, always positive. z has no units. A positive z is above the mean; a negative z is below it; z = 0 is the mean.</p><p>If X ∼ N(μ, σ²), then Z = (X − μ)/σ has mean 0 and SD 1: the <b>standard normal distribution</b>.</p><h3>Worked example · simulated systolic blood pressure</h3><p>Assume μ = 125 mmHg and σ = 8 mmHg. Find the z-score for 133 mmHg.</p><div class="steps"><div><b>1 · Name the values</b>x = 133, μ = 125, σ = 8.</div><div><b>2 · Subtract the mean</b>133 − 125 = 8 mmHg above the mean.</div><div><b>3 · Divide by the SD</b>z = 8/8 = 1. The measurement is one SD above the mean.</div></div><div id="zchecks"></div><h3>Try your own values</h3><label>x <input id="zx" type="number" value="117" step="any"></label><label>μ <input id="zm" type="number" value="125" step="any"></label><label>σ <input id="zs" type="number" value="8" step="any" min="0.00001"></label><button onclick="zcalc()">Explain my z-score</button><div id="zout" aria-live="polite"></div><div class="note">The z formula can describe distance for other datasets too. A normal probability table is appropriate only when a normal model is justified or explicitly assumed.</div></div></section>
<section class="section" data-title="4. Read the normal table"><div class="card"><h2>This table gives the right-hand tail</h2><p>The attached Mathematics Support Centre worksheets use <b>T(z) = P(Z &gt; z)</b> for positive z. We use that convention throughout. Other tables may show P(Z &lt; z) or P(0 &lt; Z &lt; z); always read the heading first.</p><div id="tablecurve"></div><h3>How to read z = 0.43</h3><ol><li>Split 0.43 into <b>0.4 + 0.03</b>.</li><li>Find row <b>0.4</b> and column <b>.03</b>.</li><li>The intersection is <b>0.3336</b>.</li><li>So P(Z &gt; 0.43) = 0.3336 = <b>33.36%</b>.</li></ol><label>Find z <input type="number" id="lookup" value="0.43" step="0.01" min="0" max="3.99"></label><button onclick="lookupTable(true)">Highlight row & column</button><div id="lookupout" class="note" aria-live="polite"></div><p class="small">Full positive-z right-tail table, rounded to four decimal places. Click a cell to see the corresponding shaded tail.</p><div class="tablewrap" id="ztable"></div><div class="note">For table work, round the calculated z to two decimal places, then read the four-decimal probability. For very large positive z, the tail approaches zero. A printed 0.0000 is rounded, not literally zero.</div><div id="tablechecks"></div></div></section>
<section class="section" data-title="5. Find probabilities"><div class="card"><h2>Choose the area before the arithmetic</h2><p>Write T(z) for the positive-z right-tail table entry. For a &gt; 0:</p><table><tr><th>Region</th><th>Using our table</th><th>Why</th></tr><tr><td>P(Z &gt; a)</td><td>T(a)</td><td>Read directly</td></tr><tr><td>P(Z &lt; a)</td><td>1 − T(a)</td><td>Everything except right tail</td></tr><tr><td>P(Z &lt; −a)</td><td>T(a)</td><td>Symmetry</td></tr><tr><td>P(Z &gt; −a)</td><td>1 − T(a)</td><td>Complement of lower tail</td></tr><tr><td>P(0 &lt; Z &lt; a)</td><td>0.5 − T(a)</td><td>Right half minus tail</td></tr><tr><td>P(a &lt; Z &lt; b), 0 ≤ a &lt; b</td><td>T(a) − T(b)</td><td>Large tail minus small tail</td></tr><tr><td>P(−a &lt; Z &lt; b), a,b &gt; 0</td><td>1 − T(a) − T(b)</td><td>Remove both outside tails</td></tr></table><p>A general alternative is to convert to left areas F(z): F(z) = 1 − T(z) for z ≥ 0, and F(z) = T(|z|) for z &lt; 0. Then <b>P(a &lt; Z &lt; b) = F(b) − F(a)</b>, including intervals with two negative boundaries.</p><h3>Follow a worked example</h3><label>Choose <select id="example" onchange="showExample()"><option value="0">Right tail · blood pressure above 133</option><option value="1">Left tail · blood pressure below 133</option><option value="2">Negative z · below 117</option><option value="3">Mean to a boundary · 125 to 133</option><option value="4">Two positive boundaries · 128.44 to 130.76</option><option value="5">Crossing the mean · 117 to 133</option><option value="6">Two negative boundaries · 109 to 117</option></select></label><p>All use the hypothetical model μ = 125 mmHg, σ = 8 mmHg.</p><div id="examplecurve"></div><div id="examplebody" class="steps"></div><button id="nextstep" onclick="revealStep()">Reveal next step</button><div id="probchecks"></div></div><div class="card"><h3>Explore a probability</h3><p>Calculate, inspect the shaded region, and compare the table-based answer with the numerical model.</p><label>μ <input type="number" id="pm" value="125" step="any"></label><label>σ <input type="number" id="ps" value="8" step="any"></label><br><label>Region <select id="region"><option value="less">Below upper bound</option><option value="greater">Above lower bound</option><option value="between" selected>Between bounds</option></select></label><label>Lower x <input type="number" id="pa" value="117" step="any"></label><label>Upper x <input type="number" id="pb" value="133" step="any"></label><button onclick="probcalc()">Sketch & calculate</button><div id="probout" aria-live="polite"></div></div></section>
<section class="section" data-title="6. Work backwards"><div class="card"><h2>From a percentage to a measurement</h2><p>So far we started with x and found an area. Now the area is given and we need x. The same formula can be rearranged:</p><div class="formula">x = μ + zσ</div><div class="note"><b>Top 30%</b> means a right-tail area of 0.30. <b>Bottom 30%</b> means a left-tail area of 0.30. The sketch determines the sign of z; the table alone does not.</div><h3>Worked example · minimum blood pressure of the highest 30%</h3><p>Use μ = 125 mmHg and σ = 8 mmHg. The requested cutoff has 30% to its right.</p><div id="reversecurve"></div><div class="steps"><div><b>1 · Sketch and choose the side</b>The upper 30% is less than half the area, so the cutoff is above μ and z is positive.</div><div><b>2 · Search the body of the table</b>Find the entry nearest 0.3000. It is 0.3015 in row 0.5, column .02. Thus z ≈ 0.52. The nearby 0.2981 at 0.53 is slightly farther away.</div><div><b>3 · Return to original units</b>x = 125 + 0.52(8) = <b>129.16 mmHg</b>. This is the approximate minimum of the highest 30% in this model.</div></div><p>For the <b>lowest 30%</b>, symmetry gives z ≈ −0.52 and x = 125 − 0.52(8) = <b>120.84 mmHg</b>.</p><h3>When the mean is unknown</h3><p>A simulated saline filling process has σ = 0.5 g. Choose μ so 85% of fills exceed 500 g.</p><div class="formula">μ = x − zσ</div><ol><li>P(X &gt; 500) = 0.85, so P(X &lt; 500) = 0.15.</li><li>The 500 g cutoff is below the mean, so z is negative.</li><li>Closest table entry to 0.15 is 0.1492, so z ≈ −1.04.</li><li>μ = 500 − (−1.04)(0.5) = <b>500.52 g</b>.</li></ol><p>Double negative matters: the mean must be greater than 500 g to put 85% of the distribution above 500 g.</p><div id="reversechecks"></div></div><div class="card"><h3>Reverse-table explorer</h3><label>Find <select id="revkind"><option value="cut">Cutoff x</option><option value="mean">Unknown mean μ</option></select></label><label>Area <select id="revside"><option value="top">Top / above</option><option value="bottom">Bottom / below</option></select></label><label>Percentage <input type="number" id="revpct" value="30" step="any" min="0" max="100"></label><br><label>Known μ or cutoff x <input type="number" id="revknown" value="125" step="any"></label><label>σ <input type="number" id="revsd" value="8" step="any"></label><button onclick="reverseCalc()">Find nearest table entry</button><div id="revout" aria-live="polite"></div></div></section>
<section class="section worksheet" data-title="7. Guided worksheet"><div class="card"><h2>MATHEMATICS<br>SUPPORT CENTRE</h2><h3>Title: The Normal Distribution</h3><p><b>Target:</b> On completion of this worksheet you should know the characteristics of the normal distribution and be able to use Normal Tables.</p><p class="small">Adapted learning format from the supplied Mathematics Support Centre worksheets, Coventry University (2001). Scenarios and teaching explanations adapted for this module.</p><div class="noprint"><button onclick="window.print()">Print this worksheet</button> <button class="secondary" onclick="toggleSolutions(this)">Show all worked answers</button></div><div class="twocol"><div class="box"><b>Remember</b><p>The curve is symmetric. Mean = median = mode. Total area = 1. About 68%, 95%, 99.7% lie within 1, 2, 3 SD respectively.</p><b>Always draw a small sketch first.</b><p>Write the mean, mark the boundaries and shade the region. Then standardise.</p><div class="formula">z = (x − μ)/σ</div></div><div class="box"><b>Example · hypothetical pulse rates</b><p>μ = 76 bpm, σ = 6 bpm.</p><p>P(X &gt; 76) = 0.5.<br>P(70 &lt; X &lt; 82) ≈ 0.68.<br>P(X &gt; 88) ≈ 0.025.</p><p>The last result uses the empirical rule. The normal table gives 0.0228 beyond z = 2: the rule is rounded.</p></div><div class="box"><b>Example · the table</b><p>P(Z &gt; 0.43) = 0.3336.<br>P(Z &lt; 0.43) = 1 − 0.3336 = 0.6664.<br>P(0 &lt; Z &lt; 0.43) = 0.5 − 0.3336 = 0.1664.<br>P(Z &lt; −0.43) = 0.3336.</p></div><div class="box"><b>Example · between two values</b><p>P(0.43 &lt; Z &lt; 0.72) = T(0.43) − T(0.72) = 0.3336 − 0.2358 = 0.0978.</p><p><b>Correction to supplied sheet:</b> one example prints T(0.72) as 0.2350 and the difference as 0.0986. Correct values are 0.2358 and 0.0978.</p></div></div><div class="box"><b>Before calculating: definitions and sketches</b><p>Write definitions of mean (with formula), median, mode, distribution, and the 68–95–99.7 rule. List four normal-curve properties.</p><textarea id="definitions" placeholder="Write your definitions and properties here..."></textarea><p>Use Section 2 to classify shapes A–D. Explain what makes a normal approximation reasonable.</p><textarea id="shapeReason" placeholder="A–D and reasons..."></textarea></div><p><b>Exercise:</b> Use the question bank below. Enter proportions as decimals (0.25 means 25%), unless the question asks for a measurement or count. For F, use the empirical rule; for A–E use four-decimal table entries. For G–H use the nearest two-decimal z from the table.</p><label class="noprint">Exercise group <select id="groupfilter" onchange="renderQuestions()"></select></label><div id="questions"></div><div class="box"><b>Further exercises · Reflection</b><p>Sketch one top-percentage cutoff and one bottom-percentage cutoff. Explain the sign of z. Explain how an unknown-mean problem differs from an unknown-cutoff problem.</p><textarea id="reflection" placeholder="Record your sketches on paper and explain your reasoning here..."></textarea></div><p class="source">Source format: Mathematics Support Centre, Coventry University, 2001. Content coverage also follows the supplied Data Summary, Presentation & Normal Distribution worksheet. All application contexts here are hypothetical medical or health-service contexts. No Coventry University affiliation is implied.</p></div></section>
<section class="section" data-title="8. Exit ticket & finish"><div class="card"><h2>Can you explain it on your own?</h2><p>Complete these without opening worked answers. Then check and revisit any section you need.</p><div id="exitchecks"></div><h3>Explain your thinking</h3><p>A student reads 0.1587 from the right-tail table at z = 1 and says that P(Z &lt; 1) = 0.1587. Explain the mistake and correct it.</p><textarea id="exitexplain" placeholder="Write your explanation..."></textarea><details><summary>Compare your explanation</summary><p>The table gives P(Z &gt; 1), not P(Z &lt; 1). The area to the left is 1 − 0.1587 = 0.8413. The sketch should shade most of the curve.</p></details><label>My confidence <select id="confidence"><option>Choose…</option><option>I can explain and solve independently</option><option>I can solve with the table guide</option><option>I need help choosing the shaded area</option><option>I need help with z or rearranging formulas</option></select></label><div class="note">Download your responses and submit the file if your lecturer asks. Include paper sketches or photographs separately. This module does not send responses to your lecturer.</div><button onclick="exportWork()">Download my responses</button> <button class="secondary" onclick="downloadModule()">Download offline module</button><p class="small">The offline HTML file opens in a browser and needs no internet. Browser progress may not transfer between the hosted and downloaded copies.</p><details><summary>Lecturer notes & source coverage</summary><p>Suggested sequence: empirical rule and shapes; z and table; areas; reverse problems; worksheet and exit ticket. Allow multiple lessons or independent study for the complete bank. Section 7 can be printed by exercise group.</p><p>Worksheet 1: empirical applications, direct tails, complements, mean-to-z, negative z, between two values and z standardisation are included. Worksheet 2: all Exercise A and B problem patterns are included with medical contexts. The data-summary worksheet is covered through vocabulary, four shape classifications, both numerical datasets, empirical intervals and expected counts.</p><p>Corrected source issues: the 0.72 table entry is 0.2358; 0.3336 − 0.2358 = 0.0978. The eight-number mean is 68/8 = 8.5. Parentheses are required in (5 + 6)/2. For 45 observations within three SDs, expected count is 44.865, approximately 45. A bell-shaped histogram suggests rather than proves normality.</p><p>All worked solutions are available for formative practice. Progress is browser-local, not an LMS gradebook. Use a separate assessment for secure grading.</p></details></div></section>
<div class="footerbar"><button class="secondary" id="prev" onclick="go(current-1)">← Previous</button><button id="next" onclick="go(current+1)">Next lesson →</button></div></main></div><script>
const questions=[{"group": "A · Right-tail probabilities", "prompt": "P(Z > 0.03)", "answer": 0.488, "work": "Find row 0.0, column 0.03. The right-tail table gives 0.4880.", "tol": 0.00011}, {"group": "A · Right-tail probabilities", "prompt": "P(Z > 0.10)", "answer": 0.4602, "work": "Find row 0.1, column 0.00. The right-tail table gives 0.4602.", "tol": 0.00011}, {"group": "A · Right-tail probabilities", "prompt": "P(Z > 0.22)", "answer": 0.4129, "work": "Find row 0.2, column 0.02. The right-tail table gives 0.4129.", "tol": 0.00011}, {"group": "A · Right-tail probabilities", "prompt": "P(Z > 0.33)", "answer": 0.3707, "work": "Find row 0.3, column 0.03. The right-tail table gives 0.3707.", "tol": 0.00011}, {"group": "A · Right-tail probabilities", "prompt": "P(Z > 0.52)", "answer": 0.3015, "work": "Find row 0.5, column 0.02. The right-tail table gives 0.3015.", "tol": 0.00011}, {"group": "A · Right-tail probabilities", "prompt": "P(Z > 0.94)", "answer": 0.1736, "work": "Find row 0.9, column 0.04. The right-tail table gives 0.1736.", "tol": 0.00011}, {"group": "B · Left of a positive z", "prompt": "P(Z < 0.03)", "answer": 0.512, "work": "Complement: 1 − T(0.03) = 1 − 0.4880 = 0.5120.", "tol": 0.00011}, {"group": "B · Left of a positive z", "prompt": "P(Z < 0.52)", "answer": 0.6985, "work": "Complement: 1 − T(0.52) = 1 − 0.3015 = 0.6985.", "tol": 0.00011}, {"group": "B · Left of a positive z", "prompt": "P(Z < 0.94)", "answer": 0.8264, "work": "Complement: 1 − T(0.94) = 1 − 0.1736 = 0.8264.", "tol": 0.00011}, {"group": "C · From the mean to z", "prompt": "P(0 < Z < 0.04)", "answer": 0.016, "work": "Subtract the tail from the right half: 0.5 − 0.4840 = 0.0160.", "tol": 0.00011}, {"group": "C · From the mean to z", "prompt": "P(0 < Z < 0.51)", "answer": 0.195, "work": "Subtract the tail from the right half: 0.5 − 0.3050 = 0.1950.", "tol": 0.00011}, {"group": "C · From the mean to z", "prompt": "P(0 < Z < 0.62)", "answer": 0.2324, "work": "Subtract the tail from the right half: 0.5 − 0.2676 = 0.2324.", "tol": 0.00011}, {"group": "C · From the mean to z", "prompt": "P(0 < Z < 0.73)", "answer": 0.2673, "work": "Subtract the tail from the right half: 0.5 − 0.2327 = 0.2673.", "tol": 0.00011}, {"group": "C · From the mean to z", "prompt": "P(0 < Z < 0.90)", "answer": 0.3159, "work": "Subtract the tail from the right half: 0.5 − 0.1841 = 0.3159.", "tol": 0.00011}, {"group": "C · From the mean to z", "prompt": "P(0 < Z < 1.03)", "answer": 0.3485, "work": "Subtract the tail from the right half: 0.5 − 0.1515 = 0.3485.", "tol": 0.00011}, {"group": "D · Negative z and symmetry", "prompt": "P(Z < −0.01)", "answer": 0.496, "work": "Reflect the left tail: P(Z < −0.01) = P(Z > 0.01) = 0.4960.", "tol": 0.00011}, {"group": "D · Negative z and symmetry", "prompt": "P(Z < −0.13)", "answer": 0.4483, "work": "Reflect the left tail: P(Z < −0.13) = P(Z > 0.13) = 0.4483.", "tol": 0.00011}, {"group": "D · Negative z and symmetry", "prompt": "P(Z < −0.54)", "answer": 0.2946, "work": "Reflect the left tail: P(Z < −0.54) = P(Z > 0.54) = 0.2946.", "tol": 0.00011}, {"group": "D · Negative z and symmetry", "prompt": "P(Z < −0.72)", "answer": 0.2358, "work": "Reflect the left tail: P(Z < −0.72) = P(Z > 0.72) = 0.2358.", "tol": 0.00011}, {"group": "D · Negative z and symmetry", "prompt": "P(Z < −0.83)", "answer": 0.2033, "work": "Reflect the left tail: P(Z < −0.83) = P(Z > 0.83) = 0.2033.", "tol": 0.00011}, {"group": "D · Negative z and symmetry", "prompt": "P(Z < −1.02)", "answer": 0.1539, "work": "Reflect the left tail: P(Z < −1.02) = P(Z > 1.02) = 0.1539.", "tol": 0.00011}, {"group": "E · Between two positive z values", "prompt": "P(0.02 < Z < 0.12)", "answer": 0.0398, "work": "Larger tail minus smaller tail: 0.4920 − 0.4522 = 0.0398.", "tol": 0.00011}, {"group": "E · Between two positive z values", "prompt": "P(0.23 < Z < 0.33)", "answer": 0.0383, "work": "Larger tail minus smaller tail: 0.4090 − 0.3707 = 0.0383.", "tol": 0.00011}, {"group": "E · Between two positive z values", "prompt": "P(0.32 < Z < 0.51)", "answer": 0.0695, "work": "Larger tail minus smaller tail: 0.3745 − 0.3050 = 0.0695.", "tol": 0.00011}, {"group": "E · Between two positive z values", "prompt": "P(0.61 < Z < 0.73)", "answer": 0.0382, "work": "Larger tail minus smaller tail: 0.2709 − 0.2327 = 0.0382.", "tol": 0.00011}, {"group": "E · Between two positive z values", "prompt": "P(0.31 < Z < 0.82)", "answer": 0.1722, "work": "Larger tail minus smaller tail: 0.3783 − 0.2061 = 0.1722.", "tol": 0.00011}, {"group": "E · Between two positive z values", "prompt": "P(0.54 < Z < 0.91)", "answer": 0.1132, "work": "Larger tail minus smaller tail: 0.2946 − 0.1814 = 0.1132.", "tol": 0.00011}, {"group": "F · Empirical-rule medical applications", "prompt": "Recovery time after a simulated procedure is normal: μ = 90 min, σ = 15 min. (a) Proportion below 90 min?", "answer": 0.5, "work": "The mean divides the area into equal halves.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Same recovery times: (b) proportion between 75 and 105 min?", "answer": 0.68, "work": "75 = 90 − 15 and 105 = 90 + 15. Use approximately 68% within one SD.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Same recovery times: (c) proportion below 60 min?", "answer": 0.025, "work": "60 is two SD below the mean. (1 − 0.95) / 2 = 0.025.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Medical implant diameters are normal: μ = 1.40 cm, σ = 0.01 cm. (a) proportion above 1.40?", "answer": 0.5, "work": "The area above the mean is 0.5.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Same implant diameters: (b) proportion between 1.38 and 1.42?", "answer": 0.95, "work": "Both boundaries are two SD from the mean; approximately 95%.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Same implant diameters: (c) proportion above 1.42?", "answer": 0.025, "work": "The upper tail beyond two SD is about 2.5%.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Saline container fill mass is normal: μ = 500 g, σ = 5 g. (a) proportion between 500 and 505 g?", "answer": 0.34, "work": "Half of the central 68% is 34%.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Same fill masses: (b) proportion above 505 g?", "answer": 0.16, "work": "(1 − 0.68) / 2 = 0.16.", "tol": 0.001}, {"group": "F · Empirical-rule medical applications", "prompt": "Same fill masses: (c) proportion below 495 g?", "answer": 0.16, "work": "Symmetry gives the same 0.16 lower tail.", "tol": 0.001}, {"group": "G · Further exercises — Exercise A", "prompt": "Blood pressure: μ = 125 mmHg, σ = 8 mmHg. Minimum of highest 50%?", "answer": 125, "work": "Use the closest right-tail table entry and the sketch to choose z = 0.00. x = μ + zσ = 125 + (0)(8) = 125.00.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Same blood pressure model. Minimum of highest 30%?", "answer": 129.16, "work": "Use the closest right-tail table entry and the sketch to choose z = 0.52. x = μ + zσ = 125 + (0.52)(8) = 129.16.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Same blood pressure model. Maximum of lowest 30%?", "answer": 120.84, "work": "Use the closest right-tail table entry and the sketch to choose z = -0.52. x = μ + zσ = 125 + (-0.52)(8) = 120.84.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Same blood pressure model. Minimum of highest 20%?", "answer": 131.72, "work": "Use the closest right-tail table entry and the sketch to choose z = 0.84. x = μ + zσ = 125 + (0.84)(8) = 131.72.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Clinical skills scores: μ = 68 points, σ = 10 points. Minimum of top 45%?", "answer": 69.3, "work": "Use the closest right-tail table entry and the sketch to choose z = 0.13. x = μ + zσ = 68 + (0.13)(10) = 69.30.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Same clinical skills scores. Minimum of top 15%?", "answer": 78.4, "work": "Use the closest right-tail table entry and the sketch to choose z = 1.04. x = μ + zσ = 68 + (1.04)(10) = 78.40.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Same clinical skills scores. Cutoff for bottom 20%?", "answer": 59.6, "work": "Use the closest right-tail table entry and the sketch to choose z = -0.84. x = μ + zσ = 68 + (-0.84)(10) = 59.60.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Specimen processing time: μ = 5 min, σ = 1 min. Minimum time of slowest 15%?", "answer": 6.04, "work": "Use the closest right-tail table entry and the sketch to choose z = 1.04. x = μ + zσ = 5 + (1.04)(1) = 6.04.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Same processing times. Maximum time of quickest 37%?", "answer": 4.67, "work": "Use the closest right-tail table entry and the sketch to choose z = -0.33. x = μ + zσ = 5 + (-0.33)(1) = 4.67.", "tol": 0.011}, {"group": "G · Further exercises — Exercise A", "prompt": "Hospital stay costs: μ = $20,000, σ = $5,000. Minimum cost of highest 70%?", "answer": 17400.0, "work": "Use the closest right-tail table entry and the sketch to choose z = -0.52. x = μ + zσ = 20000 + (-0.52)(5000) = 17400.00.", "tol": 0.011}, {"group": "H · Further exercises — Exercise B", "prompt": "A saline filling process has σ = 0.5 g. Set μ so 80% of fills exceed 500 g.", "answer": 500.42, "work": "Locate the requested tail; the signed z is -0.84. Rearrange z = (x − μ)/σ to μ = x − zσ = 500 − (-0.84)(0.5) = 500.42.", "tol": 0.011}, {"group": "H · Further exercises — Exercise B", "prompt": "A medical supply filling process has σ = 0.5 kg. Set μ so 70% of containers weigh at least 26 kg.", "answer": 26.26, "work": "Locate the requested tail; the signed z is -0.52. Rearrange z = (x − μ)/σ to μ = x − zσ = 26 − (-0.52)(0.5) = 26.26.", "tol": 0.011}, {"group": "H · Further exercises — Exercise B", "prompt": "Clinical skills scores have σ = 10 points. If 42% score at least 67, find μ.", "answer": 65.0, "work": "Locate the requested tail; the signed z is 0.20. Rearrange z = (x − μ)/σ to μ = x − zσ = 67 − (0.2)(10) = 65.00.", "tol": 0.011}, {"group": "H · Further exercises — Exercise B", "prompt": "Hospital stay costs have σ = $10,000. If 70% cost at least $20,000, find μ.", "answer": 25200.0, "work": "Locate the requested tail; the signed z is -0.52. Rearrange z = (x − μ)/σ to μ = x − zσ = 20000 − (-0.52)(10000) = 25200.00.", "tol": 0.011}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Observation times (minutes): 6, 2, 3, 5, 4, 9, 12, 27. Find the mean.", "answer": 8.5, "work": "Sum = 68; n = 8; 68 / 8 = 8.5.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Same times. Find the median.", "answer": 5.5, "work": "Order: 2, 3, 4, 5, 6, 9, 12, 27. Median = (5 + 6) / 2 = 5.5.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Frequency data: number of clinic visits = 1, 2, 3, 7, 8; frequencies = 1, 2, 5, 4, 2. Find the mean.", "answer": 4.571428571428571, "work": "Σfx = 64 and Σf = 14; weighted mean = 64 / 14 ≈ 4.5714.", "tol": 0.005}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Same clinic visit frequency data. Find the median.", "answer": 3, "work": "There are 14 observations. The 7th and 8th are both 3.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Same clinic visit frequency data. Find the mode.", "answer": 3, "work": "3 visits has the largest frequency: 5.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "A simulated monthly rehabilitation duration is normal with μ = 48 h, σ = 3.24 h. Lower boundary of central 68%?", "answer": 44.76, "work": "48 − 3.24 = 44.76 h; upper boundary 51.24 h.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Same rehabilitation duration. Lower boundary of central 95%?", "answer": 41.52, "work": "48 − 2(3.24) = 41.52 h; upper boundary 54.48 h.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "Same rehabilitation duration. Lower boundary of central 99.7%?", "answer": 38.28, "work": "48 − 3(3.24) = 38.28 h; upper boundary 57.72 h.", "tol": 0.001}, {"group": "I · Data summary and empirical-rule worksheet", "prompt": "45 simulated pulse measurements are modeled as normal: μ = 76 bpm, σ = 5.6 bpm. Expected number between 59.2 and 92.8 bpm? Enter the unrounded expected count.", "answer": 44.865, "work": "Bounds are μ ± 3σ. Expected count = 45(0.997) = 44.865, approximately 45 people. This is an estimate, not a guaranteed count.", "tol": 0.001}];
const sections=[...document.querySelectorAll('.section')];let current=0;let state={};try{state=JSON.parse(localStorage.getItem('normalHealthV1')||'{}')}catch(e){}let visited=new Set(state.visited||[]);function save(){state.visited=[...visited];state.current=current;try{localStorage.setItem('normalHealthV1',JSON.stringify(state))}catch(e){document.getElementById('status').textContent='Browser storage unavailable. Download responses before closing.'}}
function go(n){current=Math.max(0,Math.min(sections.length-1,n));sections.forEach((s,i)=>s.classList.toggle('active',i===current));document.querySelectorAll('nav button').forEach((b,i)=>{b.classList.toggle('active',i===current);b.setAttribute('aria-current',i===current?'step':'false')});visited.add(current);document.getElementById('progress').style.width=(visited.size/8*100)+'%';document.getElementById('prev').disabled=current===0;document.getElementById('next').disabled=current===7;save();window.scrollTo({top:0,behavior:'smooth'})}
document.getElementById('nav').innerHTML=sections.map((s,i)=>`<button onclick="go(${i})">${s.dataset.title}</button>`).join('');
function cdf(z){if(z===Infinity)return 1;if(z===-Infinity)return 0;const x=Math.abs(z),t=1/(1+.2316419*x);const p=.3989422804014327*Math.exp(-x*x/2)*t*(.319381530+t*(-.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))));return z>=0?1-p:p}
function tail(z){return +(1-cdf(z)).toFixed(4)}function ftable(z){return z<0?tail(-z):1-tail(z)}
function curve(a,b,mu=0,sd=1,caption='Shaded probability region'){let path='',shade='';const X=z=>45+(z+4)*65,Y=z=>205-170*Math.exp(-z*z/2);for(let i=0;i<=320;i++){let z=-4+i/40;path+=(i?'L':'M')+X(z)+','+Y(z);if(z>=a&&z<=b)shade+=(shade?'L':'M')+X(z)+','+Y(z)}let lo=Math.max(-4,a),hi=Math.min(4,b);let fill=lo<hi?`<path d="M${X(lo)},205 L${X(lo)},${Y(lo)} ${shade.replace(/^M/,'L')} L${X(hi)},205 Z" fill="#8bd1c6"/>`:'';let ticks='';for(let z=-3;z<=3;z++)ticks+=`<line x1="${X(z)}" y1="205" x2="${X(z)}" y2="211" stroke="#678"/><text x="${X(z)}" y="230" text-anchor="middle">${+(mu+z*sd).toFixed(2)}</text>`;let bounds='';for(const z of [a,b])if(Number.isFinite(z)&&z>-4&&z<4)bounds+=`<line x1="${X(z)}" y1="205" x2="${X(z)}" y2="${Y(z)}" stroke="#9b5c13" stroke-dasharray="4 3"/><text x="${X(z)}" y="${Math.max(20,Y(z)-10)}" text-anchor="middle">${+(mu+z*sd).toFixed(2)}</text>`;return `<svg viewBox="0 0 610 260" role="img" aria-label="${caption}"><title>${caption}</title>${fill}<path d="${path}" fill="none" stroke="#087e83" stroke-width="3"/><line x1="40" y1="205" x2="575" y2="205" stroke="#678"/>${ticks}${bounds}<text x="305" y="255" text-anchor="middle">${mu===0&&sd===1?'z-score':'Measurement (original units)'}</text></svg>`}
function empirical(){let k=+document.getElementById('bands').value,p=[0,68,95,99.7][k];document.getElementById('empcurve').innerHTML=curve(-k,k,76,6,`About ${p}% of pulse rates are between ${76-k*6} and ${76+k*6} bpm`);document.getElementById('emptext').innerHTML=`Move ${k} × 6 = ${k*6} bpm each way: <b>${76-k*6} to ${76+k*6} bpm</b>. About <b>${p}%</b> lies inside. Outside: ${(100-p).toFixed(1)}%; each tail: ${((100-p)/2).toFixed(2)}%.`}
let checkIds=[];function checkHTML(id,prompt,answer,work,tol=.00011){checkIds.push(id);return `<div class="check"><p><b>${prompt}</b></p><label>Your answer <input id="${id}" type="number" step="any" aria-label="${prompt.replace(/"/g,'&quot;')}"></label> <button onclick='checkValue(${JSON.stringify(id)},${answer},${tol},${JSON.stringify(work).replace(/'/g,'&#39;')})'>Check answer</button><div id="${id}f" class="feedback" aria-live="polite"></div><details><summary>Worked answer</summary><p>${work}</p><p>Answer: <b>${Number.isInteger(answer)?answer:answer.toFixed(4)}</b></p></details></div>`}
function checkValue(id,a,t,w){let el=document.getElementById(id),f=document.getElementById(id+'f');if(el.value.trim()===''){f.textContent='Enter an answer first.';return}let ok=Number.isFinite(+el.value)&&Math.abs(+el.value-a)<=t;f.className='feedback '+(ok?'good':'retry');f.textContent=ok?'✓ Correct. '+w:'Try again. Sketch the region and check the units. Open the worked answer for guidance.';state[id]=el.value;state[id+'correct']=ok;save()}
document.getElementById('empchecks').innerHTML=checkHTML('c1','What percentage lies above 88 bpm? Enter a percentage.',2.5,'88 = 76 + 2(6). Split the outside 5% into two equal tails.',.01)+checkHTML('c2','What percentage lies between the mean and one SD above it?',34,'Half of the central 68% is 34%.',.01);
document.getElementById('zchecks').innerHTML=checkHTML('c3','Find z for 117 mmHg when μ = 125 and σ = 8.',-1,'z = (117 − 125)/8 = −1. This is one SD below the mean.',.001);
document.getElementById('tablechecks').innerHTML=checkHTML('c4','Read P(Z > 0.52). Enter a decimal proportion.',.3015,'Row 0.5, column .02 gives 0.3015.');
document.getElementById('probchecks').innerHTML=checkHTML('c5','Find P(Z < −0.43). Enter a decimal.',.3336,'By symmetry, this equals P(Z > 0.43) = 0.3336.')+checkHTML('c6','Find P(0.43 < Z < 0.72). Enter a decimal.',.0978,'0.3336 − 0.2358 = 0.0978.');
document.getElementById('reversechecks').innerHTML=checkHTML('c7','Minimum of the highest 20%: μ = 125, σ = 8. Use z = 0.84. Enter mmHg.',131.72,'x = 125 + 0.84(8) = 131.72 mmHg.',.011);
document.getElementById('exitchecks').innerHTML=checkHTML('e1','1. Approximately what percentage lies within 2 SD of μ?',95,'The empirical rule gives about 95%.',.01)+checkHTML('e2','2. Find z for x = 90, μ = 76, σ = 7.',2,'(90 − 76)/7 = 2.',.001)+checkHTML('e3','3. P(Z < 0.52)? Enter a decimal.',.6985,'1 − 0.3015 = 0.6985.')+checkHTML('e4','4. P(−1 < Z < 1)? Use table entries, not the empirical rule.',.6826,'1 − 0.1587 − 0.1587 = 0.6826.')+checkHTML('e5','5. Lab measurement μ = 100 units, σ = 12 units. Minimum of highest 30%, using z = 0.52?',106.24,'100 + 0.52(12) = 106.24 units.',.011);
function zcalc(){let x=+document.getElementById('zx').value,m=+document.getElementById('zm').value,s=+document.getElementById('zs').value;let o=document.getElementById('zout');if(!valid(['zx','zm','zs'])||s<=0){o.textContent='Enter finite values with σ > 0.';return}let z=(x-m)/s;o.innerHTML=`<div class="note">z = (${x} − ${m}) / ${s} = <b>${z.toFixed(4)}</b>. The value is ${Math.abs(z).toFixed(4)} SD ${z<0?'below':z>0?'above':'from'} the mean.</div>`+curve(-Infinity,z,m,s)}
function valid(ids){return ids.every(id=>{let v=document.getElementById(id).value;return v.trim()!==''&&Number.isFinite(+v)})}
function buildTable(){let h='<table><thead><tr><th>z · T(z)</th>';for(let c=0;c<10;c++)h+=`<th>.0${c}</th>`;h+='</tr></thead><tbody>';for(let r=0;r<40;r++){h+=`<tr><td class="rowhead">${(r/10).toFixed(1)}</td>`;for(let c=0;c<10;c++){let z=r/10+c/100;h+=`<td data-z="${z.toFixed(2)}" onclick="selectZ('${z.toFixed(2)}')" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectZ('${z.toFixed(2)}')}">${tail(z).toFixed(4)}</td>`}h+='</tr>'}document.getElementById('ztable').innerHTML=h+'</tbody></table>'}
function selectZ(z){document.getElementById('lookup').value=z;lookupTable(false)}function lookupTable(scroll){let v=document.getElementById('lookup').value,z=+v;if(v.trim()===''||!Number.isFinite(z)||z<0||z>3.99){document.getElementById('lookupout').textContent='Enter z between 0.00 and 3.99.';return}z=+z.toFixed(2);document.querySelectorAll('#ztable td').forEach(c=>c.classList.remove('selected','axis'));const cell=document.querySelector(`[data-z="${z.toFixed(2)}"]`);if(cell){cell.classList.add('selected');cell.parentElement.firstChild.classList.add('axis');if(scroll)document.getElementById('ztable').scrollTop=cell.parentElement.offsetTop-110}document.getElementById('lookupout').textContent=`z = ${z.toFixed(2)}: row ${(Math.floor(Math.round(z*100)/10)/10).toFixed(1)}, column .${String(Math.round(z*100)%10).padStart(2,'0')}. P(Z > ${z.toFixed(2)}) = ${tail(z).toFixed(4)} = ${(tail(z)*100).toFixed(2)}%.`;document.getElementById('tablecurve').innerHTML=curve(z,Infinity,0,1,`Right tail above z = ${z.toFixed(2)}`)}
const examples=[
{a:1,b:Infinity,s:['Sketch: mark 125 and 133 mmHg. Shade above 133. The region is smaller than half.','Standardise: z = (133 − 125)/8 = 1.00.','Read row 1.0, column .00: T(1.00) = 0.1587.','Interpret: P(X > 133) = 0.1587, about 15.87% in this model. The empirical estimate would be 16%.']},
{a:-Infinity,b:1,s:['Sketch: shade everything below 133 mmHg, including the centre. Expect more than 0.5.','Standardise: z = (133 − 125)/8 = 1.00.','Table: T(1.00) = 0.1587 is the unwanted right tail.','Complement: 1 − 0.1587 = 0.8413. About 84.13% lie below 133 mmHg.']},
{a:-Infinity,b:-1,s:['Sketch: shade below 117 mmHg. This is a small left tail.','Standardise: (117 − 125)/8 = −1.00.','Reflect across the mean: P(Z < −1) = P(Z > 1).','Read T(1) = 0.1587. About 15.87% lie below 117 mmHg.']},
{a:0,b:1,s:['Sketch: shade from the mean 125 up to 133.','Standardise endpoints: 0 and 1.','The right half has area 0.5. The tail beyond 1 is 0.1587.','Subtract: 0.5 − 0.1587 = 0.3413, about 34.13%.']},
{a:.43,b:.72,s:['Sketch: shade only the narrow band from 128.44 to 130.76 mmHg. Both lie above μ.','Standardise: (128.44 − 125)/8 = 0.43; (130.76 − 125)/8 = 0.72.','Look up T(0.43) = 0.3336 and T(0.72) = 0.2358.','Subtract the smaller tail: 0.3336 − 0.2358 = 0.0978, or 9.78%.']},
{a:-1,b:1,s:['Sketch: shade from 117 to 133, crossing the mean.','Standardise: lower z = −1, upper z = 1.','Each outside tail is T(1) = 0.1587.','Remove both tails: 1 − 0.1587 − 0.1587 = 0.6826 = 68.26%. This is close to the empirical 68%.']},
{a:-2,b:-1,s:['Sketch: shade from 109 to 117, entirely below μ.','Standardise: (109 − 125)/8 = −2 and (117 − 125)/8 = −1.','By symmetry, use the band from +1 to +2. T(1) = 0.1587 and T(2) = 0.0228.','Subtract: 0.1587 − 0.0228 = 0.1359, about 13.59%.']}
];let step=0;function showExample(){step=0;let e=examples[+document.getElementById('example').value];document.getElementById('examplecurve').innerHTML=curve(e.a,e.b,125,8);document.getElementById('examplebody').innerHTML='';document.getElementById('nextstep').disabled=false;revealStep()}function revealStep(){let e=examples[+document.getElementById('example').value];if(step<e.s.length){document.getElementById('examplebody').innerHTML+=`<div><b>Step ${step+1}</b>${e.s[step]}</div>`;step++}document.getElementById('nextstep').disabled=step>=e.s.length}
function probcalc(){let m=+document.getElementById('pm').value,s=+document.getElementById('ps').value,a=+document.getElementById('pa').value,b=+document.getElementById('pb').value,r=document.getElementById('region').value,o=document.getElementById('probout');if(!valid(['pm','ps',...(r==='less'?['pb']:r==='greater'?['pa']:['pa','pb'])])||s<=0||(r==='between'&&a>=b)){o.textContent='Enter finite values, σ > 0, and a lower bound smaller than the upper bound.';return}let za=r==='less'?-Infinity:(a-m)/s,zb=r==='greater'?Infinity:(b-m)/s;let ra=Number.isFinite(za)?+za.toFixed(2):za,rb=Number.isFinite(zb)?+zb.toFixed(2):zb;let exact=cdf(zb)-cdf(za),f=z=>z===Infinity?1:z===-Infinity?0:ftable(z),p=f(rb)-f(ra);o.innerHTML=curve(za,zb,m,s)+`<div class="note">z boundaries: ${Number.isFinite(za)?za.toFixed(4):'−∞'} and ${Number.isFinite(zb)?zb.toFixed(4):'+∞'}.<br>Rounded z: ${ra}, ${rb}.<br>Table-based probability = <b>${p.toFixed(4)}</b> (${(p*100).toFixed(2)}%).<br>Numerical normal-model probability ≈ ${exact.toFixed(6)}. Differences arise from rounding the z-scores and table entries.</div>`}
function reverseCalc(){let p=+document.getElementById('revpct').value/100,k=+document.getElementById('revknown').value,s=+document.getElementById('revsd').value,kind=document.getElementById('revkind').value,side=document.getElementById('revside').value,o=document.getElementById('revout');if(!valid(['revpct','revknown','revsd'])||p<=0||p>=1||s<=0){o.textContent='Use a percentage strictly between 0 and 100 and σ > 0.';return}let left=side==='top'?1-p:p,target=Math.min(left,1-left),best=0,err=Infinity;for(let i=0;i<=399;i++){let z=i/100,d=Math.abs(tail(z)-target);if(d<err){best=z;err=d}}let z=left<.5?-best:best,value=kind==='cut'?k+z*s:k-z*s;let m=kind==='cut'?k:value;let cut=kind==='cut'?value:k;let outOfRange=target<tail(3.99);o.innerHTML=curve(side==='top'?z:-Infinity,side==='top'?Infinity:z,m,s)+`<div class="note">Left area = ${left.toFixed(4)}; positive-z tail target = ${target.toFixed(4)}.<br>Closest table entry = ${tail(best).toFixed(4)} at |z| = ${best.toFixed(2)}. Sign from sketch: z = ${z.toFixed(2)}.<br>${kind==='cut'?'x = μ + zσ':'μ = x − zσ'} = ${k} ${kind==='cut'?'+':'−'} (${z.toFixed(2)})(${s}) = <b>${value.toFixed(2)}</b>.<br>Boundary = ${cut.toFixed(2)}; mean = ${m.toFixed(2)}.${outOfRange?'<br>The requested tail is beyond this table’s useful range. This boundary value is only a table-limit approximation.':''}</div>`}
const groups=[...new Set(questions.map(q=>q.group))];document.getElementById('groupfilter').innerHTML='<option value="all">All exercises</option>'+groups.map((g,i)=>`<option value="${i}">${g}</option>`).join('');function renderQuestions(){let f=document.getElementById('groupfilter').value,h='',g='';questions.forEach((q,i)=>{if(f!=='all'&&q.group!==groups[+f])return;if(q.group!==g){g=q.group;h+=`<h3 style="text-align:left;margin-top:30px">${g}</h3>`}h+=`<div class="q"><p><b>${i+1}.</b> ${q.prompt}</p>${checkHTML('q'+i,'Answer',q.answer,q.work,q.tol)}</div>`});document.getElementById('questions').innerHTML=h;restore()}
function toggleSolutions(button){let ds=document.querySelectorAll('#questions details'),open=button.textContent.startsWith('Show');ds.forEach(d=>d.open=open);button.textContent=open?'Hide all worked answers':'Show all worked answers'}
function shape(type){let vals=Array.from({length:13},(_,i)=>type==='A'?8+2*i:type==='B'?35*Math.exp(-.5*((i-6)/2.2)**2):type==='C'?35*Math.exp(-.5*((i-6)/1.5)**2):10+(i%2)*2);return `<svg viewBox="0 0 300 135" role="img" aria-label="Distribution ${type}">${vals.map((v,i)=>`<rect x="${12+i*21}" y="${110-v*2.4}" width="18" height="${v*2.4}" fill="#68b2a8"/>`).join('')}<line x1="10" y1="110" x2="288" y2="110" stroke="#536b6d"/><text x="150" y="130" text-anchor="middle">Hypothetical health measurements</text></svg>`}
document.getElementById('shapes').innerHTML=['A','B','C','D'].map(t=>`<div class="card"><b>Distribution ${t}</b>${shape(t)}<label>Normal approximation? <select id="shape${t}" onchange="shapeCheck('${t}')"><option value="">Choose…</option><option value="yes">Reasonable</option><option value="no">Not reasonable</option></select></label><div class="feedback" id="shape${t}f" aria-live="polite"></div></div>`).join('');function shapeCheck(t){let v=document.getElementById('shape'+t).value;let ok=v===((t==='B'||t==='C')?'yes':'no');document.getElementById('shape'+t+'f').textContent=!v?'':ok?'✓ '+((t==='B'||t==='C')?'Roughly symmetric with one bell-shaped peak.':'This shape does not resemble a symmetric bell.'):'Look again: is there one central peak with similar tails on each side?';state['shape'+t]=v;save()}
function restore(){document.querySelectorAll('input[id],textarea[id],select[id]').forEach(el=>{if(state[el.id]!==undefined)el.value=state[el.id]})}
document.addEventListener('input',e=>{if(e.target.id&&e.target.matches('input,textarea,select')){state[e.target.id]=e.target.value;save()}});document.addEventListener('change',e=>{if(e.target.id&&e.target.matches('select')){state[e.target.id]=e.target.value;save()}});
function download(name,text,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}function exportWork(){let lines=['NORMAL DISTRIBUTION · MY RESPONSES','Saved: '+new Date().toLocaleString(),''];for(const id of ['c1','c2','c3','c4','c5','c6','c7','e1','e2','e3','e4','e5']){const el=document.getElementById(id);lines.push((el?el.getAttribute('aria-label'):id)+': '+(state[id]||'(no answer)'))}questions.forEach((q,i)=>lines.push((i+1)+'. '+q.prompt+'\nMy answer: '+(state['q'+i]||'(no answer)')));for(const id of ['definitions','shapeReason','reflection','exitexplain','confidence'])lines.push(id+': '+(state[id]||'(no response)'));download('Normal_Distribution_My_Responses.txt',lines.join('\n\n'),'text/plain')}
function downloadModule(){const a=document.createElement('a');a.href='Normal_Distribution_Interactive_Module.html';a.download='Normal_Distribution_Interactive_Module.html';a.click()}
buildTable();renderQuestions();restore();empirical();lookupTable(false);showExample();document.getElementById('reversecurve').innerHTML=curve(.52,Infinity,125,8,'Upper 30% cutoff, approximately 129.16 mmHg');go(Number.isInteger(state.current)?state.current:0);
</script></body></html>
